HOST=0.0.0.0
# full requires all existing integrations. connections enables only workspace
# creation, sender creation/read and email connection through the shared flow.
# It refuses job, CRM, LinkedIn and Mailivery credentials and closes their routes.
LIFTY_RUNTIME_PROFILE=full
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
PUBLIC_BASE_URL=https://api.liftygtm.com
HUBSPOT_CLIENT_ID=replace_with_lifty_app_client_id
HUBSPOT_CLIENT_SECRET=replace_with_lifty_app_client_secret
SLACK_CLIENT_ID=replace_with_lifty_app_client_id
SLACK_CLIENT_SECRET=replace_with_lifty_app_client_secret
# Optional: LIFT's Attio OAuth app (redirect URI <PUBLIC_BASE_URL>/attio/callback).
ATTIO_CLIENT_ID=
ATTIO_CLIENT_SECRET=
TRIGGER_SECRET_KEY=tr_prod_replace_me
# TRIGGER_API_URL=https://api.trigger.dev
# The notifications service's own Trigger.dev project, for notification test
# sends. Required, and never the same key as TRIGGER_SECRET_KEY.
NOTIFICATIONS_TRIGGER_SECRET_KEY=tr_prod_replace_me_notifications
# NOTIFICATIONS_TRIGGER_API_URL=https://api.trigger.dev

# Optional email connection. Configure all three together.
# The dedicated key is separate from Unipile credentials and grants only the
# reviewed email RPC. Provision its SHA-256 + stable provider namespace in DB.
# UNIPILE_DSN=https://apiXXX.unipile.com:PORT
# UNIPILE_ACCESS_TOKEN=deployment-secret
# Legacy warmup identification: same stable credential scope as Jobs and DB.
# UNIPILE_PROVIDER_NAMESPACE=your-reviewed-organization-scope
# Enable only after Unipile activates this CNAME and its TLS certificate.
# UNIPILE_HOSTED_AUTH_ORIGIN=https://connect.liftygtm.com
# LIFTY_EMAIL_SERVER_KEY=random-secret-at-least-32-characters

# Optional Mailivery warmup (LIF-989). Needed only to mint the hosted Mailivery
# connection form; without it warmup start fails closed and changes nothing.
# Status, pause, resume and remove use the founder session RPC.
# MAILIVERY_API_KEY=deployment-secret

# LIF-995: OAuth setup is a v1 launch requirement. Enable only after the same
# Google client ID/secret are saved in Mailivery (Team Settings → API Access).
# The flag is literal true/false and defaults off.
# LIFTY_WARMUP_SETUP_ENABLED=true
# Lifty's one Google OAuth client. The ID alone is public: the email connect
# page shows it in the Workspace Trusted instructions, so it must also be the
# client configured in this runtime's Unipile application.
# LIFTY_WARMUP_GOOGLE_CLIENT_ID=123456789012-example.apps.googleusercontent.com
# LIFTY_WARMUP_GOOGLE_CLIENT_SECRET=deployment-secret
# Optional custom HTTPS origin for the warmup page and Google callback. Keep
# PUBLIC_BASE_URL for the existing HubSpot, Slack and other API callbacks.
# LIFTY_WARMUP_PUBLIC_BASE_URL=https://warmup.liftygtm.com

# Authenticated lead research dashboard (separate from this API).
LIFTY_DASHBOARD_ORIGIN=https://liftygtm.com

# Optional LinkedIn account connections. Reuses the provider credentials above,
# with a capability distinct from email; email can be disabled.
# Provision this key's SHA-256 + namespace in private.lifty_linkedin_server_config.
# LIFTY_LINKEDIN_SERVER_KEY=different-random-secret-at-least-32-characters

# Native company mapping capability. Store only SHA-256 of this distinct random
# 32-256 character key in private.lifty_crm_server_config. No Supabase admin key.
# LIFTY_CRM_SERVER_KEY=dedicated-random-crm-capability-secret

# Preserve company apply maintenance freeze when moving from Edge to API.
# CONSUMER_READ_ONLY_MODE=false
# DASHBOARD_READ_ONLY_MODE=false

# Optional staged Unipile V2 transport (LIF-916). V1 settings above stay in place.
# Configuring credentials does not migrate or activate any workspace.
# UNIPILE_V2_ACCESS_TOKEN=application-scoped-v2-secret
# UNIPILE_V2_APPLICATION_ID=app_replace_me
# Required with V2: comma-separated Lifty-branded HTTPS origins (the database's
# v2_hosted_auth_origin); retain old domains until links expire. Unipile's
# default auth.unipile.com and V1 account.unipile.com are never allowed.
# UNIPILE_V2_HOSTED_AUTH_ORIGINS=https://auth.liftygtm.com

# Optional product analytics (LIF-1663): the PostHog project API key the
# dashboards already use (phc_...). Absent means the API captures nothing.
# POSTHOG_API_KEY=phc_replace_me
# POSTHOG_HOST=https://us.i.posthog.com
