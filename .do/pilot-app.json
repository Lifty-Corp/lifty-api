{
  "name": "lifty-api-pilot",
  "region": "sfo",
  "domains": [{ "domain": "api.pilot.liftygtm.com", "type": "PRIMARY" }],
  "alerts": [{ "rule": "DEPLOYMENT_FAILED" }, { "rule": "DOMAIN_FAILED" }],
  "ingress": { "rules": [{ "match": { "path": { "prefix": "/" } }, "component": { "name": "api" } }] },
  "services": [{
    "name": "api",
    "git": { "repo_clone_url": "https://github.com/Lifty-Corp/lifty-api.git", "branch": "develop" },
    "dockerfile_path": "Dockerfile",
    "source_dir": "/",
    "instance_size_slug": "apps-s-1vcpu-0.5gb",
    "instance_count": 1,
    "http_port": 3000,
    "health_check": { "initial_delay_seconds": 5, "period_seconds": 10, "timeout_seconds": 2, "success_threshold": 1, "failure_threshold": 3, "http_path": "/readyz" },
    "liveness_health_check": { "initial_delay_seconds": 5, "period_seconds": 10, "timeout_seconds": 2, "success_threshold": 1, "failure_threshold": 3, "http_path": "/healthz" }
  }]
}
